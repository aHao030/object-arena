{
  "name": "object-arena",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "tsx apps/server/src/index.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build": "vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "start": "tsx apps/server/src/index.ts",
    "lab": "node apps/lab/src/cli.js"
  },
  "dependencies": {
    "@astryxdesign/core": "0.7.13",
    "@astryxdesign/theme-neutral": "0.7.13",
    "@colyseus/core": "0.18.28",
    "@colyseus/sdk": "0.18.10",
    "@colyseus/ws-transport": "0.18.5",
    "@dimforge/rapier3d-compat": "0.21.0",
    "@heroicons/react": "2.2.0",
    "@mujoco/mujoco": "4.0.0",
    "@stylexjs/stylex": "0.19.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.7.13",
    "@stylexjs/babel-plugin": "0.19.1",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "5.1.1",
    "concurrently": "9.2.5",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.8"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
